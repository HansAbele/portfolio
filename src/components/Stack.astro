---
import { COPY, type Lang } from "../data/copy";
import TechChip from "./TechChip.astro";

interface Props {
  lang?: Lang;
}

const { lang = "es" } = Astro.props;
const t = COPY[lang];
---

<section id="stack" class="stack" aria-labelledby="stack-title">
  <div class="container">
    <p class="eyebrow">
      <span><span class="num">04</span> / {t.stack.title}</span>
    </p>
    <h2 id="stack-title" class="section-title">{t.stack.title}</h2>

    <div class="stack-grid">
      {t.stack.groups.map((group) => (
        <article class="card stack-card">
          <h3 class="stack-name">{group.name}</h3>
          <ul class="stack-items">
            {group.items.map((item) => (
              <li><TechChip name={item} /></li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .stack-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
  }

  .stack-card {
    padding: 26px 28px;
  }

  .stack-name {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 16px;
    font-weight: 500;
  }

  .stack-items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  @media (max-width: 860px) {
    .stack-grid {
      grid-template-columns: 1fr;
    }
    .stack-card {
      padding: 26px;
    }
  }
</style>
