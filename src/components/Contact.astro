---
import { COPY, SOCIALS, PHONE_DISPLAY, type Lang } from "../data/copy";
import ContactForm from "./ContactForm.astro";
import IconMail from "./icons/IconMail.astro";
import IconPhone from "./icons/IconPhone.astro";
import IconLinkedin from "./icons/IconLinkedin.astro";
import IconGithub from "./icons/IconGithub.astro";

interface Props {
  lang?: Lang;
}

const { lang = "es" } = Astro.props;
const t = COPY[lang];
---

<section id="contact" class="contact" aria-labelledby="contact-title">
  <div class="container">
    <h2 id="contact-title" class="contact-title">{t.contact.title}</h2>
    <p class="contact-sub">{t.contact.subtitle}</p>

    <ContactForm lang={lang} />

    <ul class="socials contact-socials" aria-label={t.a11y.socials}>
      <li>
        <a class="social" href={SOCIALS.email} aria-label="Email">
          <IconMail size={16} />
        </a>
      </li>
      <li>
        <a
          class="social"
          href={SOCIALS.phone}
          aria-label={`Phone ${PHONE_DISPLAY}`}
          title={PHONE_DISPLAY}
        >
          <IconPhone size={16} />
        </a>
      </li>
      <li>
        <a class="social" href={SOCIALS.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
          <IconLinkedin size={16} />
        </a>
      </li>
      <li>
        <a class="social" href={SOCIALS.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub">
          <IconGithub size={16} />
        </a>
      </li>
    </ul>

    <p class="contact-phone">
      <a href={SOCIALS.phone}>{PHONE_DISPLAY}</a>
    </p>
  </div>
</section>

<style>
  .contact {
    text-align: center;
    padding: 80px 0 60px;
  }

  .contact .container {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .contact-title {
    font-size: clamp(32px, 4.4vw, 50px);
    letter-spacing: -0.035em;
    font-weight: 700;
    line-height: 1;
    margin: 0 0 16px;
    background: linear-gradient(135deg, var(--ink), var(--accent));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .contact-sub {
    max-width: 460px;
    margin: 0 auto 32px;
    font-size: 15px;
    color: var(--ink-2);
    line-height: 1.6;
  }

  .contact-socials {
    margin: 32px 0 0;
    list-style: none;
    padding: 0;
  }

  /* Phone number rendered visibly below the pills — most recruiters
     scanning a portfolio in a hurry won't hover the icons to find a
     number. Plain text reads instantly and is still tel-link tappable. */
  .contact-phone {
    margin: 14px 0 0;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--muted);
    letter-spacing: 0.04em;
  }

  .contact-phone a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s var(--ease-out-quart);
  }

  .contact-phone a:hover {
    color: var(--accent);
  }
</style>
