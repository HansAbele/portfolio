---
import { COPY, type Lang } from "../data/copy";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  lang?: Lang;
}

const { lang = "es" } = Astro.props;
const t = COPY[lang];

const navItems = [
  { href: "#about", label: t.nav.about, id: "about" },
  { href: "#experience", label: t.nav.experience, id: "experience" },
  { href: "#projects", label: t.nav.projects, id: "projects" },
  { href: "#stack", label: t.nav.stack, id: "stack" },
  { href: "#contact", label: t.nav.contact, id: "contact" },
];

const themeLabels = lang === "es"
  ? { light: "Cambiar a modo claro", dark: "Cambiar a modo oscuro" }
  : { light: "Switch to light mode", dark: "Switch to dark mode" };

const langLabel = lang === "es" ? "Idioma" : "Language";
---

<header class="header" aria-label={lang === "es" ? "Navegación principal" : "Primary navigation"}>
  <a href={lang === "es" ? "/" : "/en"} class="header-brand" aria-label={lang === "es" ? "Johan Taveras — inicio" : "Johan Taveras — home"}>
    <span class="header-brand-dot" aria-hidden="true"></span>
    <span>Johan Taveras</span>
  </a>

  <nav data-nav>
    {navItems.map((item) => (
      <a href={item.href} data-section={item.id}>{item.label}</a>
    ))}
  </nav>

  <div class="header-actions">
    <ThemeToggle labelLight={themeLabels.light} labelDark={themeLabels.dark} />

    <div class="lang-toggle" role="group" aria-label={langLabel}>
      <a
        class:list={["lang-link", { active: lang === "es" }]}
        href="/"
        data-lang="es"
        aria-current={lang === "es" ? "true" : "false"}
      >
        ES
      </a>
      <a
        class:list={["lang-link", { active: lang === "en" }]}
        href="/en"
        data-lang="en"
        aria-current={lang === "en" ? "true" : "false"}
      >
        EN
      </a>
    </div>
  </div>
</header>

<style>
  .header {
    position: fixed;
    top: 18px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 50;
    width: min(960px, calc(100% - 32px));
    padding: 8px 10px 8px 22px;
    border-radius: 999px;
    background: var(--glass-2);
    backdrop-filter: blur(20px) saturate(140%);
    -webkit-backdrop-filter: blur(20px) saturate(140%);
    border: 1px solid var(--glass-stroke);
    box-shadow: var(--glass-shadow);
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .header-brand {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--ink);
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
  }

  .header-brand-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    box-shadow: 0 0 12px var(--accent);
  }

  nav {
    display: flex;
    gap: 4px;
    margin: 0 auto;
  }

  nav a {
    font-size: 13.5px;
    color: var(--ink-2);
    text-decoration: none;
    padding: 7px 14px;
    border-radius: 999px;
    transition: background 0.2s, color 0.2s;
    font-weight: 500;
    position: relative;
  }

  nav a:hover {
    background: rgba(0, 0, 0, 0.04);
    color: var(--ink);
  }

  nav a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  nav a[aria-current="true"] {
    color: var(--ink);
    background: rgba(107, 92, 255, 0.08);
  }

  :global([data-theme="dark"]) nav a:hover {
    background: rgba(255, 255, 255, 0.06);
  }

  :global([data-theme="dark"]) nav a[aria-current="true"] {
    background: rgba(107, 92, 255, 0.18);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .lang-toggle {
    display: flex;
    background: rgba(0, 0, 0, 0.04);
    border-radius: 999px;
    padding: 3px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
  }

  :global([data-theme="dark"]) .lang-toggle {
    background: rgba(255, 255, 255, 0.06);
  }

  .lang-link {
    background: transparent;
    border: 0;
    padding: 5px 10px;
    border-radius: 999px;
    cursor: pointer;
    color: var(--muted);
    letter-spacing: 0.05em;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    transition: background 0.2s, color 0.2s;
  }

  .lang-link:hover {
    color: var(--ink-2);
  }

  .lang-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .lang-link.active {
    background: var(--ink);
    color: var(--bg);
  }

  @media (max-width: 860px) {
    .header {
      width: calc(100% - 24px);
    }
    nav {
      display: none;
    }
  }
</style>

<script>
  /**
   * Preserve the current section hash when switching languages,
   * so /#projects ⇄ /en#projects.
   */
  function bindLangPreserveHash() {
    const links = document.querySelectorAll<HTMLAnchorElement>("[data-lang]");
    links.forEach((link) => {
      link.addEventListener("click", (event) => {
        const hash = window.location.hash;
        if (!hash) return;
        // Only intercept same-tab navigation
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) return;
        event.preventDefault();
        const url = new URL(link.href);
        url.hash = hash;
        window.location.assign(url.toString());
      });
    });
  }

  bindLangPreserveHash();
  document.addEventListener("astro:page-load", bindLangPreserveHash);
</script>

<script>
  /**
   * Scroll-spy — highlights the nav link of the section currently in view.
   * Uses IntersectionObserver with a top-anchored rootMargin so the active
   * link is the section that owns the upper portion of the viewport.
   */
  function bindScrollSpy() {
    const nav = document.querySelector("[data-nav]");
    if (!nav) return;

    const links = nav.querySelectorAll<HTMLAnchorElement>("a[data-section]");
    if (!links.length) return;

    const sectionMap = new Map<string, HTMLAnchorElement>();
    links.forEach((link) => {
      const id = link.dataset.section;
      if (id) sectionMap.set(id, link);
    });

    const sections = Array.from(sectionMap.keys())
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null);

    if (!sections.length) return;

    const setActive = (id: string | null) => {
      links.forEach((link) => {
        const isActive = link.dataset.section === id;
        if (isActive) {
          link.setAttribute("aria-current", "true");
        } else {
          link.removeAttribute("aria-current");
        }
      });
    };

    const observer = new IntersectionObserver(
      (entries) => {
        // Pick the entry highest in the viewport that is intersecting.
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible[0]) {
          setActive(visible[0].target.id);
        }
      },
      {
        rootMargin: "-30% 0px -60% 0px",
        threshold: 0,
      }
    );

    sections.forEach((s) => observer.observe(s));
  }

  bindScrollSpy();
  document.addEventListener("astro:page-load", bindScrollSpy);
</script>
