---
import { COPY, type Lang } from "../data/copy";

interface Props {
  lang?: Lang;
}

const { lang = "es" } = Astro.props;
const t = COPY[lang];
---

<footer class="footer">
  <div class="container footer-grid">
    <p class="footer-credit">{t.footer.credit}</p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    margin-top: 40px;
  }

  .footer-grid {
    padding: 32px 28px 40px;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .footer-credit {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--muted);
    letter-spacing: 0.04em;
    margin: 0;
    text-transform: none;
    text-align: center;
  }
</style>
