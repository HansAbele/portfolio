---
import IconSun from "./icons/IconSun.astro";
import IconMoon from "./icons/IconMoon.astro";

interface Props {
  labelLight?: string;
  labelDark?: string;
}

const { labelLight = "Cambiar a modo claro", labelDark = "Cambiar a modo oscuro" } = Astro.props;
---

<button
  type="button"
  class="theme-toggle"
  data-theme-toggle
  data-label-light={labelLight}
  data-label-dark={labelDark}
  aria-label={labelDark}
>
  <span class="icon icon-sun" aria-hidden="true">
    <IconSun size={15} />
  </span>
  <span class="icon icon-moon" aria-hidden="true">
    <IconMoon size={15} />
  </span>
</button>

<style>
  .theme-toggle {
    width: 36px;
    height: 30px;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.04);
    border: 0;
    color: var(--ink-2);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    position: relative;
    transition:
      background 0.2s var(--ease-out-quart),
      color 0.2s var(--ease-out-quart);
  }

  :global([data-theme="dark"]) .theme-toggle {
    background: rgba(255, 255, 255, 0.06);
  }

  .theme-toggle:hover {
    color: var(--accent);
  }

  .theme-toggle:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .icon {
    position: absolute;
    inset: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition:
      opacity 0.25s var(--ease-out-quart),
      transform 0.4s var(--ease-out-quart);
  }

  /* Light theme: show moon (click → switches to dark) */
  :global(:root[data-theme="light"]) .icon-sun {
    opacity: 0;
    transform: rotate(-90deg) scale(0.6);
  }
  :global(:root[data-theme="light"]) .icon-moon {
    opacity: 1;
    transform: rotate(0) scale(1);
  }

  /* Dark theme: show sun (click → switches to light) */
  :global(:root[data-theme="dark"]) .icon-sun {
    opacity: 1;
    transform: rotate(0) scale(1);
  }
  :global(:root[data-theme="dark"]) .icon-moon {
    opacity: 0;
    transform: rotate(90deg) scale(0.6);
  }
</style>

<script>
  /**
   * Theme toggle behavior — toggles `data-theme` on <html>, persists to localStorage.
   * The Layout's inline bootstrap script runs first to avoid FOUC.
   */
  function bindThemeToggle() {
    const buttons = document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]");
    if (!buttons.length) return;

    const updateLabel = (button: HTMLButtonElement, theme: string) => {
      const labelLight = button.dataset.labelLight ?? "";
      const labelDark = button.dataset.labelDark ?? "";
      // Show the action that the click WILL perform.
      button.setAttribute("aria-label", theme === "dark" ? labelLight : labelDark);
    };

    const sync = (theme: string) => {
      buttons.forEach((b) => updateLabel(b, theme));
    };

    sync(document.documentElement.dataset.theme ?? "light");

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        const current = document.documentElement.dataset.theme === "dark" ? "dark" : "light";
        const next = current === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem("theme", next);
        } catch {
          /* localStorage may be blocked */
        }
        sync(next);
      });
    });
  }

  bindThemeToggle();
  // Re-bind after Astro view transitions / page swaps.
  document.addEventListener("astro:page-load", bindThemeToggle);
</script>
